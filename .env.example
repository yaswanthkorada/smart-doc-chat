# ==================== APPLICATION SETTINGS ====================
APP_NAME="RAG Assistant"
APP_ENV="development"  # development, staging, production
SECRET_KEY="your-secret-key-here-change-in-production"
DEBUG=True

# ==================== AI PROVIDER ====================
# Choose: openai or gemini
AI_PROVIDER="gemini"  # Use gemini for FREE development, openai for production

# ==================== OPENAI API ====================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-3.5-turbo"  # or gpt-4, gpt-4-turbo
OPENAI_EMBEDDING_MODEL="text-embedding-ada-002"

# ==================== GOOGLE GEMINI API ====================
# Get your FREE API key from: https://makersuite.google.com/app/apikey
# FREE TIER: 1,000 requests/day, 15 requests/minute - Perfect for development!
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash-exp"  # or gemini-pro

# ==================== DATABASE ====================
# SQLite (Default - for development)
DATABASE_URL="sqlite:///./data/rag_app.db"

# PostgreSQL (Recommended for production)
# DATABASE_URL="postgresql://username:password@localhost:5432/rag_db"

# PostgreSQL on Supabase (Free tier available)
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# ==================== VECTOR DATABASE ====================
# ChromaDB (Local - Default)
VECTOR_DB_TYPE="chromadb"  # chromadb, pinecone, qdrant
CHROMA_PERSIST_DIR="./data/chroma_data"

# Pinecone (Production - Recommended)
# VECTOR_DB_TYPE="pinecone"
# PINECONE_API_KEY="your-pinecone-api-key"
# PINECONE_ENVIRONMENT="us-west1-gcp"
# PINECONE_INDEX_NAME="rag-assistant"

# Qdrant (Alternative)
# VECTOR_DB_TYPE="qdrant"
# QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY="your-qdrant-api-key"

# ==================== FILE STORAGE ====================
# Local Storage (Default - for development)
STORAGE_TYPE="local"  # local, s3, azure, gcp, r2
LOCAL_STORAGE_PATH="./data/user_files"

# AWS S3 (Production)
# STORAGE_TYPE="s3"
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="rag-assistant-documents"

# Cloudflare R2 (Recommended - No egress fees)
# STORAGE_TYPE="r2"
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="rag-documents"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Azure Blob Storage
# STORAGE_TYPE="azure"
# AZURE_STORAGE_CONNECTION_STRING="your-connection-string"
# AZURE_CONTAINER_NAME="rag-documents"

# Google Cloud Storage
# STORAGE_TYPE="gcp"
# GCS_BUCKET_NAME="rag-documents"
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"

# ==================== FILE UPLOAD LIMITS ====================
MAX_FILE_SIZE_MB=100  # Maximum file size in MB
MAX_FILES_PER_UPLOAD=10  # Maximum number of files per upload
ALLOWED_FILE_TYPES="pdf,docx,txt,pptx,xlsx,csv"

# ==================== SUBSCRIPTION TIERS ====================
# Free Tier Limits
FREE_MAX_DOCUMENTS=10
FREE_MAX_STORAGE_MB=100
FREE_MAX_CONVERSATIONS=50

# Pro Tier Limits
PRO_MAX_DOCUMENTS=1000
PRO_MAX_STORAGE_MB=10240  # 10GB
PRO_MAX_CONVERSATIONS=1000

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ==================== REDIS (Optional - for caching) ====================
REDIS_ENABLED=False
REDIS_URL="redis://localhost:6379/0"

# ==================== EMAIL SETTINGS (Optional) ====================
SMTP_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@ragassistant.com"

# ==================== ANALYTICS (Optional) ====================
GOOGLE_ANALYTICS_ID=""
POSTHOG_API_KEY=""

# ==================== LOGGING ====================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="./logs/app.log"

# ==================== CELERY (Background Tasks - Optional) ====================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ==================== SECURITY ====================
# JWT Token Settings
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=True
REQUIRE_LOWERCASE=True
REQUIRE_NUMBERS=True
REQUIRE_SPECIAL_CHARS=False

# ==================== DEPLOYMENT ====================
# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"
STREAMLIT_SERVER_HEADLESS=True
STREAMLIT_BROWSER_GATHER_USAGE_STATS=False
