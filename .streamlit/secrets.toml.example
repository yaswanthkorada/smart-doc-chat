# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git!

# ==================== API Keys ====================
[api_keys]
OPENAI_API_KEY = "sk-your-openai-key-here"
GOOGLE_API_KEY = "your-gemini-api-key-here"

# ==================== Supabase Configuration ====================
[supabase]
# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
url = "https://your-project.supabase.co"

# Supabase anon/public key (from Settings > API)
key = "your-supabase-anon-key"

# Supabase service role key (from Settings > API) - use with caution
service_role_key = "your-supabase-service-role-key"

# Your Supabase project ID
project_id = "your-project-id"

# Storage bucket name
bucket = "documents"

# Database password (from Settings > Database > Connection String)
# This is needed to connect to the PostgreSQL database
db_password = "your-database-password"

# ==================== Database Configuration ====================
# Option 1: Use the full connection string (recommended)
[database]
# Get this from Supabase: Settings > Database > Connection String (URI mode)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
connection_string = "postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Option 2: Or just provide DATABASE_URL directly
# DATABASE_URL = "postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# ==================== Other Settings (Optional) ====================
# AI Provider
AI_PROVIDER = "openai"  # or "gemini"
EMBEDDING_PROVIDER = "openai"  # or "gemini"

# Models
OPENAI_MODEL = "gpt-4"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
GEMINI_MODEL = "gemini-2.0-flash-exp"
GEMINI_EMBEDDING_MODEL = "models/embedding-001"

# Vector Database
VECTOR_DB_TYPE = "chromadb"

# File Storage
STORAGE_TYPE = "supabase"
